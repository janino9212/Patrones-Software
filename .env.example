# Copia este archivo como `.env` (no se sube al repo, ver .gitignore) y
# completa los valores reales. Sin `.env`, la app usa defaults de desarrollo
# local (Postgres local, clave JWT de desarrollo) definidos en el código.

# Connection string de Postgres (local o en la nube, p.ej. Neon).
# Formato: postgresql://usuario:password@host:puerto/basededatos?sslmode=require
DATABASE_URL=postgresql://postgres:password123@localhost:5432/scm_db?client_encoding=utf8

# Clave secreta para firmar los JWT. Generar una propia y NO reutilizar en producción,
# por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=clave-super-secreta-solo-para-desarrollo-local
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
